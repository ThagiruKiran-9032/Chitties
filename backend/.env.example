# Environment Configuration Template for Chitties
PROJECT_NAME="Chitties"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="chitties_db"
DATABASE_URL="postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/chitties_db"
TEST_DATABASE_URL="postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/chitties_test_db"

# Security & JWT (Generate a secure key with: openssl rand -hex 32)
SECRET_KEY="chitties_super_secret_development_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis (Introduced in Phase 9)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
